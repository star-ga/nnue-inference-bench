// NNUE forward pass (NKNN v2: 40960 -> 256x2 -> 32 -> 32 -> 1 + WDL 3) in MIND.
//
// Built as a shared library with `mindc nnue.mind --emit-shared <out>` and
// driven from tools/infer_mind.py through the static-shape tensor C ABI.
//
// Numerics contract (the same one the Python, C++ and CUDA paths follow):
// IEEE-754 binary32, every multiply and every add rounded on its own (no fused
// multiply-add), dense sums accumulated in input-index order starting from the
// bias. The kernel computes in f64 and rounds every result to f32 with
// `((x) as f32) as f64`. For a single + or * of two f32 values the f64 result
// rounded to f32 equals the direct f32 result, so the trace is bit-identical
// to the other implementations. The rounding is written inline rather than as
// a helper function because the helper call costs about 30x in throughput.
//
// SCReLU(x) = clamp(x, 0, 1)^2, also written inline.
//
// Layouts (all row-major, dequantized on the host):
//   w1   [40960 * 256]   w1[f * 256 + j]
//   w2   [512 * 32]      w2[i * 32 + j]
//   w3   [32 * 32]       w3[i * 32 + j]
//   w4   [32]            eval head
//   wdl  [32 * 3]        wdl[i * 3 + k]
//   feats [1024 * 64]    per position: [stm, n_white, n_black,
//                        30 white feature slots, 30 black feature slots, pad]
//                        (at most 1024 positions per call)
// h1, h2, h3 are caller-provided scratch buffers.

// Runs positions [first, first + count) and returns one value of the
// per-position verification trace of the LAST position run:
//   head 0      eval output
//   head 1..3   WDL logits
//   head 4..35  L2 pre-activations
//   head 36..67 L3 pre-activations
// head -1 instead returns the f64 sum of every trace value of every position,
// accumulated in computation order (L2, L3, then outputs). The timed path
// uses it so that no part of the computation can be optimised away.
pub fn nnue_run(w1: tensor<f64[10485760]>, b1: tensor<f64[256]>, w2: tensor<f64[16384]>, b2: tensor<f64[32]>, w3: tensor<f64[1024]>, b3: tensor<f64[32]>, w4: tensor<f64[32]>, b4: tensor<f64[1]>, wdl: tensor<f64[96]>, bwdl: tensor<f64[3]>, feats: tensor<i64[65536]>, h1: tensor<f64[512]>, h2: tensor<f64[32]>, h3: tensor<f64[32]>, first: i64, count: i64, head: i64) -> f64 {
    let mut total: f64 = 0.0;
    let mut picked: f64 = 0.0;
    let mut p: i64 = first;
    while p < first + count {
        let base: i64 = p * 64;
        let stm: i64 = feats[base];
        let nw: i64 = feats[base + 1];
        let nb: i64 = feats[base + 2];

        // L1: sparse accumulation per perspective, then SCReLU, side to move
        // first. Each accumulator lane starts at the bias and adds the active
        // feature rows in feature order.
        let mut j: i64 = 0;
        while j < 256 {
            let mut sw: f64 = b1[j];
            let mut f: i64 = 0;
            while f < nw {
                sw = ((sw + w1[feats[base + 3 + f] * 256 + j]) as f32) as f64;
                f = f + 1;
            }
            let mut sb: f64 = b1[j];
            let mut g: i64 = 0;
            while g < nb {
                sb = ((sb + w1[feats[base + 33 + g] * 256 + j]) as f32) as f64;
                g = g + 1;
            }
            if sw < 0.0 {
                sw = 0.0;
            }
            if sw > 1.0 {
                sw = 1.0;
            }
            if sb < 0.0 {
                sb = 0.0;
            }
            if sb > 1.0 {
                sb = 1.0;
            }
            let hw: f64 = ((sw * sw) as f32) as f64;
            let hb: f64 = ((sb * sb) as f32) as f64;
            if stm == 0 {
                h1[j] = hw;
                h1[256 + j] = hb;
            } else {
                h1[j] = hb;
                h1[256 + j] = hw;
            }
            j = j + 1;
        }

        // L2: 512 -> 32, SCReLU.
        let mut o2: i64 = 0;
        while o2 < 32 {
            let mut s2: f64 = b2[o2];
            let mut k2: i64 = 0;
            while k2 < 512 {
                let m2: f64 = ((h1[k2] * w2[k2 * 32 + o2]) as f32) as f64;
                s2 = ((s2 + m2) as f32) as f64;
                k2 = k2 + 1;
            }
            total = total + s2;
            if head == 4 + o2 {
                picked = s2;
            }
            let mut c2: f64 = s2;
            if c2 < 0.0 {
                c2 = 0.0;
            }
            if c2 > 1.0 {
                c2 = 1.0;
            }
            h2[o2] = ((c2 * c2) as f32) as f64;
            o2 = o2 + 1;
        }

        // L3: 32 -> 32, SCReLU.
        let mut o3: i64 = 0;
        while o3 < 32 {
            let mut s3: f64 = b3[o3];
            let mut k3: i64 = 0;
            while k3 < 32 {
                let m3: f64 = ((h2[k3] * w3[k3 * 32 + o3]) as f32) as f64;
                s3 = ((s3 + m3) as f32) as f64;
                k3 = k3 + 1;
            }
            total = total + s3;
            if head == 36 + o3 {
                picked = s3;
            }
            let mut c3: f64 = s3;
            if c3 < 0.0 {
                c3 = 0.0;
            }
            if c3 > 1.0 {
                c3 = 1.0;
            }
            h3[o3] = ((c3 * c3) as f32) as f64;
            o3 = o3 + 1;
        }

        // Heads: eval (32 -> 1) and WDL (32 -> 3), no activation.
        let mut q: i64 = 0;
        while q < 4 {
            let mut s4: f64 = 0.0;
            if q == 0 {
                s4 = b4[0];
            } else {
                s4 = bwdl[q - 1];
            }
            let mut k4: i64 = 0;
            while k4 < 32 {
                let mut wq: f64 = 0.0;
                if q == 0 {
                    wq = w4[k4];
                } else {
                    wq = wdl[k4 * 3 + q - 1];
                }
                let m4: f64 = ((h3[k4] * wq) as f32) as f64;
                s4 = ((s4 + m4) as f32) as f64;
                k4 = k4 + 1;
            }
            total = total + s4;
            if q == head {
                picked = s4;
            }
            q = q + 1;
        }
        p = p + 1;
    }
    if head < 0 {
        return total;
    }
    return picked;
}
